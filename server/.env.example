# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Optional: defaults to mongodb://localhost:27017/resume_analyzer if MongoDB is running, or runs in graceful in-memory/disabled mode if unavailable)
MONGODB_URI=mongodb://localhost:27017/resume_analyzer

# Frontend Origin for CORS
CLIENT_URL=http://localhost:5173

# Ollama AI Configuration (Optional: if not running, the application seamlessly runs using its built-in rule-based analysis engine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
